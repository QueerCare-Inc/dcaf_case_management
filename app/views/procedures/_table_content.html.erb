<!-- locals: title, table_type (for div id and tbody div id), sortable, autosortable -->

<div id="<%= table_type %>" class="margin-bottom mt-5">
  <h3 class="border-bottom title">
    <%= title %>
    <%= dashboard_table_content_tooltip_shell table_type %>
  </h3>

  <table class="table border-side" id="<%= table_type %>_table">
    <thead>
      <tr>
        <th scope="col"><!-- handle/spacer --></th>
        <th scope="col"><%= t 'common.procedure_type' %></th>
        <th scope="col"><%= t 'common.surgeon' %></th>
        <th scope="col"><%= t 'common.clinic' %></th>
        <%= th_autosortable t('common.procedure_date_short'), 'string', local_assigns %>
        <%= th_autosortable t('common.support_dates'), 'string', local_assigns %>
        <th scope="col"><%= t 'common.services' %></th>
        <th scope="col"><%= t 'common.status' %></th>
        <th scope="col"><%= t 'common.notes' %></th>
      </tr>
    </thead>

    <tbody id="<%= table_type %>_content">
      <% procedures.each do |procedure| %>
        <%# <% base_patient = Patient.where(id: procedure.patient_id).first %>
        <% care_request_entry = CareRequestEntry.where(procedure: procedure).first %>
        
        <tr class="procedure-data" id="<%= procedure.id %>">
          <% if local_assigns[:sortable] %>
            <td class="handle" scope="row">
              <i class="fas fa-arrows-alt fa-fw sortable-handle text-muted"></i>
            </td>
          <% else %>
            <td scope="row"><!-- spacer --></td>
          <% end %>

          <td><%= procedure.procedure_type_key_text %></td>
          <td><%= procedure.surgeon_display %></td>
          <td><%= procedure.clinic_display %></td>
          <td><%= procedure.procedure_date_display %></td>
          <td><%= procedure.support_dates_display %></td>
          <td>
            <% if !procedure.services.reject(&:blank?).join(', ').blank? %>
              <%= procedure.services.reject(&:blank?).join(', ') %>
            <% else %>
              <%= t('common.none') %>
            <% end %>
          </td>
          <td><%= care_request_entry.status_key_text(procedure.care_status) %></td>
          <%# <td><%= procedure.most_recent_note_display_text %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
