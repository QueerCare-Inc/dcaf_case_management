<!-- locals: title, table_type (for div id and tbody div id), sortable, autosortable -->

<div id="<%= table_type %>" class="margin-bottom mt-5">
  <h3 class="border-bottom title">
    <%= title %>
    <%# <%= dashboard_table_content_tooltip_shell table_type %> 
  </h3>

  <table class="table border-side" id="<%= table_type %>_table">
    <thead>
      <tr>
        <th scope="col"><!-- handle/spacer --></th>
        <th scope="col"><%= t 'common.street_address' %></th>
        <th scope="col"><%= t 'common.city' %></th>
        <th scope="col"><%= t 'common.phone_number' %></th>
        <%= th_autosortable t('common.start_date'), 'string', local_assigns %>
        <%= th_autosortable t('common.end_date'), 'string', local_assigns %>
        <th scope="col"><%= t 'common.confirmed' %></th>
        <th scope="col"><!-- details --></th>
        <th scope="col"><!-- delete btn --></th>
        <th scope="col"><!-- edit btn --></th>
      </tr>
    </thead>

    <tbody id="<%= table_type %>_content">
      <% care_addresses.each do |care_address| %>
        <%= render partial: 'care_addresses/care_address_row', 
                  locals: { 
                    care_address: care_address, 
                    sortable: local_assigns[:sortable] 
                    }
        %>
      <% end %>
    </tbody>
  </table>
</div>
