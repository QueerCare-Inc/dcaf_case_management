<%# <div id="new_care_address_form_content"> %>
<%= bootstrap_form_for @new_care_address_form, 
                        # html: { id: 'new_care_address_form' },
                        # url: add_care_address_procedure_path(@procedure),
                        # method: :patch,
                        # # class: 'new_care_address',
                        remote: true do |f| %>
    <%= f.hidden_field :procedure_id, value: @procedure.id %>
    <%# <%= f.hidden_field :locale, value: params[:locale] %>
    <div class="row">
        <div class="col info-form-left">
            <%= f.text_field :street_address,
                            label: t('care_address.street_address'),
                            id: 'new_care_address_street_address',
                            value: prefilled_street_address %>

            <div class="row mt-4">
                <div class="col-8">
                    <%= f.text_field :city, autocomplete: 'off' %>
                </div>

                <div class="col-4">
                    <%= f.select :state, options_for_select(state_options('AL'),
                                            'AL'), autocomplete: 'off' %>
                </div>
            </div>

            <%= f.text_field :zip,
                                label: t('care_address.zip'),
                                autocomplete: 'off' %>
            <%= f.text_field :phone_number,
                                label: t('care_address.phone_number'),
                                autocomplete: 'off' %>

            <%=  f.check_box :qc_house,
                                label: t('care_address.qc_housing'),
                                checked: false %>
        </div> 

        <div class="col info-form-right">
            <fieldset>
                <legend class="font-weight-bold" id="accessibility_options_label">
                <%= t 'care_address.accessibility.title' %>
                </legend>

                <%# ToDo: double check that the values are getting assigned properly %>
                <%= f.form_group :accessibility_options do %>
                    <div class="row">
                        <div class="col">
                            <%= f.check_box :accessibility_options, {
                                            label: t('care_address.accessibility.wheelchair_accessible'),
                                            name: 'new_care_address_form[accessibility_options][]',
                                            id: 'wheelchair_accessible_care_address_accessibility_options' },
                                            'Wheelchair accessible', '' %>
                            <%= f.check_box :accessibility_options, {
                                            label: t('care_address.accessibility.shower_grab_bar'),
                                            name: 'new_care_address_form[accessibility_options][]',
                                            id: 'shower_grab_bar_care_address_accessibility_options' },
                                            'Shower grab bar', '' %>
                            
                            <%= f.check_box :accessibility_options, {
                                            label: t('care_address.accessibility.other'),
                                            name: 'new_care_address_form[accessibility_options][]',
                                            id: 'other_accessibility_options' },
                                            'Other', '' %>
                        </div>
                    </div>
                <% end %>
            </fieldset>

            <%= f.date_field :start_date,
                                label: t('care_address.start_date'),
                                value: Date.parse(procedure.procedure_date) + 1.day,
                                required: true,
                                autocomplete: 'off' %>
            <%= f.date_field :end_date,
                                label: t('care_address.end_date'),
                                value: Date.parse(procedure.procedure_date) + 1.day,
                                required: true,
                                autocomplete: 'off' %>

            <%=  f.check_box :confirmed,
                                label: t('care_address.confirmed'),
                                checked: false %>
            <%# <%= button_to t('common.add'), 
                            @care_address.save, 
                            class:'btn btn-primary',
                            title: t('common.add'),
                            method: :patch,  #was commented out before
                            remote: true
                            %> 
            <%= f.form_group 'submit' do %>
                <%= f.submit 'Save Care Address', data: { disable_with: 'Saving...' } %>
            <% end %>
        </div>
                           
    </div> 
<% end %> 
<%# </div> %>