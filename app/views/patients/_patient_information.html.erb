<div id="patient_information_content">
  <h2><%= t 'person.information.title' %></h2>
  
  <%= bootstrap_form_with model: @patient,
                url: update_patient_and_person_path, 
                method: :patch, 
                local: false, 
                html: { id: 'patient_information_form' },
                class: 'edit_patient' do |f| %>
    <!-- Hidden fields for IDs -->
    <%= f.hidden_field :patient_id, value: @patient.id %>
    <%= f.hidden_field :person_id, value: @patient.person_id %>


    <div class="row">
      <div class="col info-form-left">
        <%= f.fields_for :person, Person.where(id: @patient.person_id).first do |person_fields| %>
          <%= render 'people/demographics', f: person_fields %>
        <% end %>
      </div>

      <div class="col info-form-right">
        <%= f.fields_for :patient, @patient do |patient_fields| %>
          <%= render 'patients/patient_demographics', f: patient_fields %>
        <% end %>
      </div>
    </div>

    <%# <div class="form-actions d-flex justify-content-end">
      <%= f.submit t('common.update'), class: 'btn btn-primary' %>
    <%# </div> %> 
  <% end %>
</div>
