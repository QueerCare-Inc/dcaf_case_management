<h3 class="mt-5 mb-5"><small><%= t('patient.new.title') %></small></h3>

<%= bootstrap_form_for @new_patient_form, remote: true do |f| %>
  <div class="row">
    <div class="col">
      <%= f.telephone_field :primary_phone,
                      label: t('common.phone_number'),
                      value: phone_number,
                      required: true
                      %>
    </div>
    <div class="col-4">
      <%= f.text_field :name,
                      label: t('common.name'),
                      value: name,
                      required: true %>
    </div>

    <%# TODO: fix this and add any other required variables for a new Person object %>
    <div class="col">
      <%= f.text_field :email,
                        label: t('common.email'),
                        value: email,
                        required: true,
                        pattern: "*@*.*" %>
    </div>  
  </div>

  <div class="row">
    <div class="col">
      <%= f.date_field :procedure_date,
                      label: t('common.procedure_date_short'),
                      value: procedure_date,
                      required: true %>
    </div>
    <div class="col">
      <%= f.select :procedure_type,
                      options_for_select(procedure_type_options),
                      label: t('common.procedure_type'),
                      value: procedure_type,
                      required: true %>
    </div>
  </div>


  <div class="row">
    <div class="col">
      <%= f.select :region_id, options_for_select(region_options, current_region.id) %>
    </div>

    <div class="col align-self-end">
      <%= f.form_group 'submit' do %>
        <%= f.primary do %>
          <i class="fas fa-plus-circle" aria-hidden="true"></i> <%= t 'patient.new.add_button' %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>