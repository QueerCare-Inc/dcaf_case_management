<div id="practical_support_content">
  <h2><%= t 'practical_support.title' %></h2>
  <p class="mb-5"><%= practical_support_guidance_link %></p>

  
  <div class="row">
    <div class="col">
      <%= render partial: 'practical_supports/support_waiver',
                  locals: {
                            patient: @patient
                          } %>

      <%= bootstrap_form_with model: @procedure,
                              url: update_practical_support_path,
                              method: :patch,
                              local: false,
                              html: {id: 'practical_support_form'},
                              class: 'edit_practical_support' do |f| %>

        <%= f.hidden_field :patient_id, value: @procedure.patient_id %>
        <%= f.hidden_field :person_id, value: @procedure.person_id %>
        <%= f.hidden_field :procedure_id, value: @procedure.id %>

        <%# <%= render partial: 'practical_supports/services_required_form',
                    locals: {
                              procedure: @procedure
                            } %>
        <%= f.fields_for :procedure, @procedure do |procedure_fields| %>
          <%= render 'practical_supports/services_required_form', f: procedure_fields %>
        <% end %> 
                            
        <%= render partial: 'care_addresses/care_address_table',
                  locals: {
                          title: t('practical.partial_titles.care_address_list'),
                          table_type: 'care_address_list',
                          care_addresses: @procedure.care_address_list(procedure),
                          sortable: true,
                          autosortable: true
                          } %>
      <% end %>
    </div>
  </div>
  <div class="row">
    <div class="col">
      <%# ToDo: revisit how this is nested %>
      <%= render partial: 'care_addresses/care_address_search_form' #,
                      # locals: { @procedure: @procedure }
                    %>
    </div>
  </div>

  <br>

  <div class="row" style="margin-top: 20px;">
    <div class="col">
      <%= render partial: 'shifts/shift_add_form'
                      # locals: { @procedure: @procedure }
                    %>
    </div>
  </div>
  <div class="row">
    <div class="col">
      <%= bootstrap_form_with model: @procedure,
                              url: update_practical_support_path,
                              method: :patch,
                              local: false,
                              html: {id: 'practical_support_form'},
                              class: 'edit_practical_support' do |f| %>
        <%= f.hidden_field :patient_id, value: @procedure.patient_id %>
        <%= f.hidden_field :person_id, value: @procedure.person_id %>
        <%= f.hidden_field :procedure_id, value: @procedure.id %>
        
        <% @shifts = @procedure.shifts.sort_by(&:start_time) %>
        <%= render partial: 'dashboards/shift_calendar',
                  locals: {
                          title: t('practical.partial_titles.shift_calendar'),
                          calendar_type: 'coordinator_cr',
                          shifts: @shifts,
                          view: 'month'
                          } %>

        <%= render partial: 'shifts/shifts_table',
                    locals: {
                            title: t('practical.partial_titles.shift_list'),
                            table_type: 'shift_list',
                            shifts: @procedure.get_page_shifts(params[:page] || 1),
                            sortable: true,
                            autosortable: true
                            } %>
      <% end %>
    </div>
  </div> 
</div>
